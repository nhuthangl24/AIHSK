# ==============================================================================
# HuáVocal AI (华语考官 AI) SaaS Environment Variables Template
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/aihsk_saas"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-random-32-character-secret-in-production"
SESSION_EXPIRY_DAYS="7"

# AI LLM Providers (Examiner & Assessment Scoring)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="..."
DEEPSEEK_API_KEY="sk-..."
AI_DEFAULT_MODEL="gpt-4o-mini"

# Speech-to-Text & Text-to-Speech
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
ELEVENLABS_API_KEY=""

# Object Storage (S3 / R2 / MinIO compatible)
S3_ENDPOINT=""
S3_BUCKET="aihsk-audio-storage"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# SaaS Billing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Background Processing & Queues
REDIS_URL="redis://localhost:6379"
NODE_ENV="production"
