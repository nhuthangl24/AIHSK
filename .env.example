# ==============================================================================
# Classnia AI (华语考官 AI) SaaS Environment Variables Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/aihsk_saas"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MAIN_SITE_URL="https://your-main-site.example.com"
# COOKIE_DOMAIN=".your-domain.com"
JWT_SECRET="replace-with-a-random-32-character-secret-in-production"
SESSION_EXPIRY_DAYS="7"

# Firebase Authentication
# Get these values from your Firebase project console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# AI LLM Gateway (HHTECH.API & Multi-Provider Support)
# HHTECH.API: Base URL https://hhtechapi.net/v1, Auth: ark-...
# Models: claude-sonnet-4.6, gpt-5.6-sol, gemini-3.7-flash, deepseek-v4.1-flash, etc.
AI_PROVIDER="hhtech"
AI_BASE_URL="https://hhtechapi.net/v1"
HHTECH_API_KEY=""
AI_API_KEY=""
AI_DEFAULT_MODEL="claude-sonnet-4.6"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="..."
DEEPSEEK_API_KEY="sk-..."

# Speech-to-Text & Text-to-Speech
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="your-azure-region"
ELEVENLABS_API_KEY=""

# Object Storage (S3 / R2 / MinIO compatible)
S3_ENDPOINT=""
S3_BUCKET="your-audio-storage-bucket"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="your-s3-region"

# SaaS Billing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Background Processing & Queues
REDIS_URL="redis://localhost:6379"
