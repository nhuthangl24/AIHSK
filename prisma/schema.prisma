generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  TEACHER
  ORG_ADMIN
  SUPER_ADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

enum AssessmentCategory {
  GENERAL
  HSK_ORIENTED
  BUSINESS
  DAILY
  CUSTOM
}

enum SessionStatus {
  DRAFT
  READY
  IN_PROGRESS
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum SpeakerType {
  EXAMINER
  LEARNER
}

enum AudioStatus {
  UPLOADED
  PROCESSED
  FAILED
}

enum RecommendationCategory {
  VOCABULARY
  GRAMMAR
  PRONUNCIATION
  STRATEGY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PlanTier {
  FREE
  PRO
  TEACHER
  ORGANIZATION
}

enum UsageMetric {
  ASSESSMENTS_COUNT
  AUDIO_SECONDS
  AI_TOKENS
}

enum NotificationType {
  ASSIGNMENT
  SCORE_READY
  SYSTEM
  BILLING
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          UserRole  @default(LEARNER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  suspendedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile            UserProfile?
  organizationMembers OrganizationMember[]
  classesTaught      Class[]              @relation("TeacherClasses")
  classesEnrolled    ClassMember[]
  assignedAssessments AssessmentAssignment[] @relation("AssignedBy")
  assessmentSessions AssessmentSession[]
  subscriptions      Subscription[]
  payments           Payment[]
  usageRecords       UsageRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]           @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLevel      String   @default("HSK 3 / B1")
  nativeLanguage   String   @default("English")
  learningGoal     String?
  studyHoursWeekly Int      @default(3)
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  logoUrl                String?
  domain                 String?
  maxSeats               Int      @default(50)
  maxAssessmentsPerMonth Int      @default(500)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  members       OrganizationMember[]
  classes       Class[]
  subscriptions Subscription[]
  payments      Payment[]
  usageRecords  UsageRecord[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(STUDENT)
  joinedAt       DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Class {
  id             String        @id @default(cuid())
  organizationId String?
  teacherId      String
  name           String
  code           String        @unique
  description    String?
  level          String        @default("Intermediate")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teacher        User          @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  members        ClassMember[]
  assignments    AssessmentAssignment[]

  @@index([teacherId])
  @@index([organizationId])
  @@index([code])
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  joinedAt  DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
}

model AssessmentTemplate {
  id                       String             @id @default(cuid())
  title                    String
  slug                     String             @unique
  description              String
  category                 AssessmentCategory @default(GENERAL)
  targetLevel              String             @default("HSK 3")
  estimatedDurationMinutes Int                @default(15)
  maxTurns                 Int                @default(10)
  stagesConfig             Json               // Stages 1-5 definitions, topics, questions
  examinerPrompt           String             // System prompt for the AI examiner
  rubricId                 String?
  isActive                 Boolean            @default(true)
  isPublic                 Boolean            @default(true)
  createdById              String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  rubric       AssessmentRubric?      @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  sessions     AssessmentSession[]
  assignments  AssessmentAssignment[]

  @@index([category])
  @@index([targetLevel])
  @@index([slug])
}

model AssessmentRubric {
  id             String   @id @default(cuid())
  name           String
  version        String   @default("1.0")
  description    String
  dimensionsJson Json     // weights, criteria, scoring guide
  passingScore   Int      @default(60)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  templates AssessmentTemplate[]
  sessions  AssessmentSession[]
}

model AssessmentAssignment {
  id           String    @id @default(cuid())
  classId      String
  templateId   String
  assignedById String
  title        String
  instructions String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  template     AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedBy   User               @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  sessions     AssessmentSession[]

  @@index([classId])
  @@index([templateId])
}

model AssessmentSession {
  id                   String        @id @default(cuid())
  assignmentId         String?
  templateId           String
  rubricId             String?
  userId               String
  status               SessionStatus @default(READY)
  currentStage         Int           @default(1)
  currentTurn          Int           @default(0)
  totalTurns           Int           @default(10)
  totalDurationSeconds Int           @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  failureReason        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  assignment AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  template   AssessmentTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rubric     AssessmentRubric?     @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  turns      ConversationTurn[]
  recordings AudioRecording[]
  result     AssessmentResult?

  @@index([userId])
  @@index([status])
  @@index([templateId])
}

model ConversationTurn {
  id                String      @id @default(cuid())
  sessionId         String
  turnIndex         Int
  stage             Int         @default(1)
  speaker           SpeakerType
  textContent       String
  pinyinContent     String?
  audioUrl          String?
  durationMs        Int?
  speechMetricsJson Json?       // e.g. pitch, pace, pauses, confidence
  createdAt         DateTime    @default(now())

  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recording     AudioRecording?
  transcription Transcription?

  @@index([sessionId, turnIndex])
}

model AudioRecording {
  id               String      @id @default(cuid())
  sessionId        String
  turnId           String?     @unique
  storageKey       String
  url              String
  mimeType         String      @default("audio/webm")
  byteSize         Int         @default(0)
  durationMs       Int         @default(0)
  status           AudioStatus @default(UPLOADED)
  acousticDataJson Json?       // Acoustic features, tone clarity metrics
  createdAt        DateTime    @default(now())

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    ConversationTurn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model Transcription {
  id               String   @id @default(cuid())
  turnId           String   @unique
  rawText          String
  pinyinText       String?
  detectedLanguage String   @default("zh-CN")
  confidence       Float    @default(0.95)
  segmentsJson     Json?
  createdAt        DateTime @default(now())

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
}

model AssessmentResult {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  rubricVersion      String   @default("1.0")
  overallScore       Float
  cefrEstimate       String   // e.g. A1, A2, B1, B2, C1, C2
  hskEstimate        String   // e.g. Unofficial HSK 3 / HSK 4 equivalent
  performanceSummary String
  confidenceLevel    Float    @default(0.9)
  isAcousticAided    Boolean  @default(true)
  strengthsJson      Json     // Array of key strengths with evidence
  weaknessesJson     Json     // Array of key weaknesses with evidence
  priorityAreasJson  Json     // Priority areas to improve
  improvementPlanJson Json    // Structured weekly learning plan
  status             String   @default("COMPLETED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session         AssessmentSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scoreDimensions ScoreDimension[]
  recommendations LearningRecommendation[]

  @@index([sessionId])
  @@index([overallScore])
}

model ScoreDimension {
  id                 String   @id @default(cuid())
  resultId           String
  dimensionKey       String   // pronunciation, fluency, vocabulary, grammar, coherence, comprehension, interaction
  dimensionName      String   // Chinese & English display name
  weight             Float    // e.g. 0.20
  score              Float    // e.g. 17.5 out of 20
  maxScore           Float    // e.g. 20.0
  performanceLevel   String   // Advanced, Proficient, Developing, Elementary
  evidenceQuotesJson Json     // Direct quotes from learner transcript
  rationale          String
  suggestionsJson    Json     // Specific actionable feedback

  result AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([dimensionKey])
}

model LearningRecommendation {
  id              String                 @id @default(cuid())
  resultId        String
  category        RecommendationCategory @default(VOCABULARY)
  originalPhrase  String?
  correctedPhrase String
  explanation     String
  exampleSentence String?
  priority        Int                    @default(1) // 1 = High, 2 = Medium, 3 = Low
  createdAt       DateTime               @default(now())

  result AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([category])
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  tier           PlanTier @default(FREE)
  priceMonthly   Int      @default(0) // cents
  priceYearly    Int      @default(0) // cents
  maxAssessments Int      @default(3)
  featuresJson   Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String?
  organizationId       String?
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String?
  organizationId        String?
  amount                Int      // cents
  currency              String   @default("usd")
  status                String   @default("succeeded")
  stripePaymentIntentId String?
  invoiceUrl            String?
  createdAt             DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
}

model UsageRecord {
  id             String      @id @default(cuid())
  userId         String?
  organizationId String?
  metric         UsageMetric
  quantity       Int         @default(1)
  recordedAt     DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([recordedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String   // e.g. "USER_LOGIN", "SESSION_FINALIZED", "ROLE_UPDATED"
  entityType   String   // e.g. "AssessmentSession", "User"
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model AIProviderConfiguration {
  id           String   @id @default(cuid())
  providerType String   // "LLM", "STT", "TTS"
  providerName String   // "openai", "anthropic", "gemini", "azure", "web_speech"
  modelId      String   // e.g. "gpt-4o", "claude-3-5-sonnet", "whisper-1"
  configJson   Json?
  isEnabled    Boolean  @default(true)
  isDefault    Boolean  @default(false)
  updatedById  String?
  updatedAt    DateTime @updatedAt
}

model BackgroundJob {
  id          String    @id @default(cuid())
  jobType     String    // "SCORING_PIPELINE", "AUDIO_PROCESSING", "REPORT_GEN"
  payloadJson Json
  status      JobStatus @default(PENDING)
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([jobType])
}
